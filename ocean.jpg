\"Treatment\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3934129380\":{\"name\":\"3934129380\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":37,\"id_type\":\"userID\",\"value\":{\"model\":\"gpt-4o\"},\"is_device_based\":false,\"passed\":false},\"3939855767\":{\"name\":\"3939855767\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":5,\"id_type\":\"userID\",\"value\":{\"section_order\":[]},\"is_device_based\":false,\"passed\":false},\"3999280432\":{\"name\":\"3999280432\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"userID\",\"value\":{\"url\":\"https://help.openai.com/articles/20001423\"},\"is_device_based\":false,\"passed\":false},\"4023951618\":{\"name\":\"4023951618\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"4051280260\":{\"name\":\"4051280260\",\"rule_id\":\"69yI5mTCm3JoNFg7p7E6Ha:100.00:2-69yI5lezTLzUufIbNZIto8\",\"secondary_exposures\":[{\"gate\":\"3856949927\",\"gateValue\":\"true\",\"ruleID\":\"1v9Hho5cW5OKH3QBu5gvIW:95.00:3\"}],\"version\":111,\"id_type\":\"userID\",\"value\":{\"templates\":[{\"id\":\"to-do-list\",\"title\":\"To-do list\",\"previewMarkdown\":\"## Today\\n\\n### Top priorities\\n\\n- [ ] Run propulsion test\\n\\n- [ ] Verify course calculations\\n\\n- [ ] Inspect fuel tanks\\n\\n### If time allows\\n\\n- [ ] Inspect radiation shields\\n\\n- [ ] Test communication systems\\n\\n- [ ] Write status report\",\"prefillPrompt\":\"Help me turn this Page into my to-do list. Check relevant conversations and connected apps you can access for things I need to do. If you can’t find enough, ask me what to add. Replace the sample tasks, keep the checkboxes and any edits I’ve made, and don’t invent tasks or deadlines.\",\"prompt\":\"Check my relevant connected apps and create a to-do checklist. Automatically update every morning at 6am in my browser time zone: check off completed tasks for me, and carry forward incomplete tasks to the next day.\"},{\"previewDocument\":[{\"kind\":\"markdown\",\"markdown\":\"## 🔴 Needs immediate attention\"},{\"markdown\":\"- Communication systems test for launch\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## ⛰️ Milestones\"},{\"layout\":\"flexible\",\"markdown\":\"| Milestone | Status |\\n| - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eProject brief\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Complete |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrototype review\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eLaunch readiness\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Upcoming |\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## ✅ Tasks\"},{\"markdown\":\"| Task | Owner | Status |\\n| - | - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eConfirm scope\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Product | Done |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eReview designs\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Design | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eTest the core flow\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Engineering | Next |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrepare launch notes\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Marketing | Next |\",\"kind\":\"markdown\",\"layout\":\"flexible\"}],\"followUp\":{\"questions\":[{\"question\":\"Which project do you want to track?\",\"options\":[],\"answerLabel\":\"Project\"},{\"question\":\"What’s the main outcome or deadline for this project?\",\"options\":[],\"answerLabel\":\"Goal or deadline\"}],\"submitLabel\":\"Create tracker\",\"preparingLabel\":\"Getting your tracker ready…\"},\"title\":\"Project tracker\",\"id\":\"project-tracker\",\"previewMarkdown\":\"## 🔴 Needs immediate attention\\n\\n- Communication systems test for launch\\n\\n## ⛰️ Milestones\\n\\n| Milestone | Status |\\n| - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eProject brief\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Complete |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrototype review\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eLaunch readiness\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Upcoming |\\n\\n## ✅ Tasks\\n\\n| Task | Owner | Status |\\n| - | - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eConfirm scope\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Product | Done |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eReview designs\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Design | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eTest the core flow\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Engineering | Next |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrepare launch notes\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Marketing | Next |\",\"prompt\":\"Check my relevant connected apps and create a project tracker. Automatically update every morning at 6am in my browser time zone.\",\"prefillPrompt\":\"Help me make this Page a tracker for my project. Use relevant conversations and connected apps you can access to find milestones and tasks, and ask me for anything missing. Replace the examples, keep my edits, and don’t guess at owners, dates, or statuses.\"},{\"id\":\"weekly-update\",\"prompt\":\"Check my relevant connected apps and create a weekly update suitable for sharing with cross-functional partners, stakeholders, and executives.\",\"prefillPrompt\":\"Help me write this week’s update on this Page. Look for progress, blockers, and next steps in relevant conversations and connected apps you can access. Ask which project or week I mean if it’s unclear, and don’t make up accomplishments.\",\"previewMarkdown\":\"## ✨ Highlights\\n\\n- Progress made\\n\\n## ☝️ Needs attention\\n\\n- Blockers and decisions needing input\\n\\n## ▶️ Next week\\n\\n- Upcoming milestones and confirmed commitments\\n\\n## 🔗 Sources\\n\\n- Links to sources\",\"followUp\":{\"freeformPlaceholder\":\"e.g. My work, the design team, or the website launch\",\"submitLabel\":\"Create update\",\"preparingLabel\":\"Getting your update ready…\",\"questions\":[{\"answerLabel\":\"Update scope\",\"options\":[],\"question\":\"What should this week's update cover?\"}]},\"title\":\"Weekly update\"},{\"id\":\"feedback-tracker\",\"prefillPrompt\":\"Help me organize feedback on this Page. Use relevant conversations and connected apps you can access to find feedback. Ask what product or topic to focus on if it’s unclear, replace the examples with what you find, and don’t invent feedback.\",\"title\":\"Feedback tracker\",\"previewMarkdown\":\"## 🔎 Top themes\\n\\n1. Make onboarding easier to follow\\n\\n2. Help people find the right resource\\n\\n3. Clarify what happens after sharing\\n\\n## 🗂️ Feedback register\\n\\n| Theme | Source | Next step |\\n| - | - | - |\\n| Onboarding | Research notes | Review the first-run flow |\\n| Navigation | Team channel | Group related resources |\\n| Sharing | Support email | Clarify confirmation copy |\\n\\n## 📝 Summary\\n\\nPeople need clearer guidance at key moments. Start with onboarding, then review navigation and sharing.\\n\\n## ▶️ Follow-ups\\n\\n- Schedule user interviews for next week\",\"prompt\":\"Check my relevant connected apps and create a feedback tracker. Ask which project I would like to track feedback for. Automatically update every morning at 6am in my browser time zone.\",\"previewDocument\":[{\"markdown\":\"## 🔎 Top themes\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"1. Make onboarding easier to follow\"},{\"kind\":\"markdown\",\"markdown\":\"2. Help people find the right resource\"},{\"markdown\":\"3. Clarify what happens after sharing\",\"kind\":\"markdown\"},{\"markdown\":\"## 🗂️ Feedback register\",\"kind\":\"markdown\"},{\"layout\":\"flexible\",\"markdown\":\"| Theme | Source | Next step |\\n| - | - | - |\\n| Onboarding | Research notes | Review the first-run flow |\\n| Navigation | Team channel | Group related resources |\\n| Sharing | Support email | Clarify confirmation copy |\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## 📝 Summary\"},{\"kind\":\"markdown\",\"markdown\":\"People need clearer guidance at key moments. Start with onboarding, then review navigation and sharing.\"},{\"markdown\":\"## ▶️ Follow-ups\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"- Schedule user interviews for next week\"}],\"followUp\":{\"preparingLabel\":\"Getting your feedback tracker ready…\",\"questions\":[{\"answerLabel\":\"Product or feature\",\"options\":[],\"question\":\"What product or feature should we collect feedback on?\"},{\"options\":[{\"value\":\"Customers and users\",\"id\":\"customers\"},{\"id\":\"internal-testers\",\"value\":\"Internal testers\"},{\"id\":\"both\",\"value\":\"Both\"}],\"question\":\"Whose feedback should we include?\",\"answerLabel\":\"Feedback sources\",\"isOther\":true}],\"submitLabel\":\"Create feedback tracker\",\"freeformPlaceholder\":\"e.g. The new onboarding flow\"}},{\"prefillPrompt\":\"Help me write release notes on this Page. Check relevant conversations and connected apps you can access for confirmed changes and limitations. Ask which release I mean if it’s unclear, and don’t add unconfirmed details or publish anything.\",\"title\":\"Release notes\",\"followUp\":{\"preparingLabel\":\"Getting your release notes ready…\",\"questions\":[{\"question\":\"What product are these release notes for?\",\"answerLabel\":\"Product\",\"options\":[]},{\"