d\\\",null,__dilConstants[\\\"29\\\"]),__dilConstants[\\\"30\\\"],__dilSafe(()=\u003e(__dil.jsx(Link,{\\\"url\\\":\\\"https://github.com/signup\\\",\\\"__resolutionId\\\":__dilConstants[\\\"31\\\"]},__dilConstants[\\\"32\\\"])),null),__dilConstants[\\\"33\\\"],__dilSafe(()=\u003e(__dil.jsx(Cite,{\\\"refs\\\":__dilConstants[\\\"34\\\"],\\\"__resolutionId\\\":__dilConstants[\\\"35\\\"]})),null)))),__dil.jsx(\\\"text\\\",null,__dilConstants[\\\"36\\\"],__dil.jsx(\\\"bold\\\",null,__dilConstants[\\\"37\\\"]),__dilConstants[\\\"38\\\"],__dilSafe(()=\u003e(__dil.jsx(Link,{\\\"url\\\":\\\"https://pixabay.com/videos/ocean-water-sunset-loop-seamless-344595/\\\",\\\"__resolutionId\\\":__dilConstants[\\\"39\\\"]},__dilConstants[\\\"40\\\"])),null),__dilConstants[\\\"41\\\"]));},{\\\"key\\\":\\\"body:0\\\"}));\",{\"_485\":822,\"_487\":823,\"_489\":824,\"_491\":825,\"_493\":826,\"_494\":360,\"_496\":827,\"_498\":828,\"_499\":829,\"_500\":830,\"_501\":831,\"_503\":832,\"_505\":833,\"_507\":834,\"_509\":835,\"_511\":836,\"_513\":837,\"_514\":838,\"_516\":839,\"_517\":341,\"_519\":840,\"_521\":841,\"_523\":842,\"_525\":843,\"_844\":845,\"_846\":847,\"_848\":849,\"_850\":851,\"_852\":853,\"_854\":855,\"_856\":857,\"_858\":352,\"_859\":860,\"_861\":862,\"_863\":864,\"_865\":710,\"_866\":867,\"_868\":869,\"_870\":871,\"_872\":769,\"_873\":874,\"_875\":876},\"好，我们从零开始，最后做出一个真正属于你的个人主页，而不是只停留在效果图。\\n\\n我建议用 **GitHub Pages + 自己的网页代码 + 免费海浪视频**。不需要购买服务器，也不用先学编程。你可以先在电脑上预览，满意后再发布到网上。\\n\\n## 我们要做的主页\\n\\nimage_group{\\\"query\\\":[\\\"cinematic deep navy blue ocean waves golden sunlight shimmering on water horizon atmospheric minimal elegant website landing page background\\\"],\\\"aspect_ratio\\\":\\\"16:9\\\",\\\"layout\\\":\\\"carousel\\\",\\\"num_per_query\\\":1}\\n\\n视觉方向参考：深海蓝、金色阳光、自然流动的海面，简洁而有电影感。\\n\\n主页会分成几个部分：\\n\\n- **海洋背景**：使用你选中的金色阳光海浪循环视频。\\n- **个人介绍**：一句你喜欢的话，配上简洁的个人信息。\\n- **常用导航**：南大相关网站、课程、AI 工具、学习资料。\\n- **动态细节**：柔和的文字动画、半透明卡片，尽量不做得花哨。\\n\\n我们会优先保证视频真的在动，而不是用一张图片假装动态背景。手机和电脑也都要能正常显示。\\n\\n## 第 1 步：确认你有没有 GitHub 账号\\n\\n先不用注册新账号，避免重复注册。我们先检查一下。\\n\\nimage_group{\\\"query\\\":[\\\"GitHub Octocat black logo white background\\\"],\\\"aspect_ratio\\\":\\\"1:1\\\",\\\"layout\\\":\\\"carousel\\\",\\\"num_per_query\\\":1}\\n\\n**打开 GitHub 官网**\\n\\n这是存放网页代码、免费发布个人主页的平台。\\n\\n[打开登录页面](https://github.com/login)\\n\\n如果你之前注册过，可以尝试用原来的邮箱登录；不确定密码时可以使用官方找回密码功能。\\n\\n打开后，根据页面情况选择：\\n\\n- **情况 A：** 已经登录，或者记得账号密码 → 告诉我。\\n- **情况 B：** 不记得有没有账号 → 可以先搜索自己的邮箱，看看是否收到过 GitHub 的注册邮件。\\n- **情况 C：** 确认没有账号 → 再去 urlGitHub 注册页面https://github.com/signup 创建免费账号。注册需要验证邮箱。citeturn217303search1turn217303search2\\n\\n先完成这一步就行，**暂时不用创建仓库，也不用下载视频**。等确认账号状态后，我再带你搭建主页，并把你选中的 url金色阳光海浪循环视频https://pixabay.com/videos/ocean-water-sunset-loop-seamless-344595/ 加进去。\",[395,774,459],{\"_378\":763},{\"_380\":764,\"_382\":383,\"_384\":765},{\"_360\":766,\"_341\":767,\"_352\":768,\"_769\":770,\"_710\":771},{},{\"_34\":390,\"_391\":808,\"_55\":809,\"_394\":395},{\"_34\":390,\"_391\":794,\"_55\":795,\"_394\":395},{\"_34\":390,\"_391\":792,\"_55\":793,\"_394\":459},\"dedf923e-efb9-5796-821d-1bd07d4a9183\",{\"_34\":390,\"_391\":790,\"_55\":791,\"_394\":459},{\"_34\":390,\"_391\":772,\"_55\":773,\"_394\":774},{\"_26\":775,\"_776\":29,\"_777\":778},[723,722],\"Cite\",[779,780],\"active_index\",\"sources_title\",\"2 个Sources\",{\"_331\":723,\"_603\":719,\"_781\":787,\"_461\":783,\"_39\":788,\"_464\":-5,\"_785\":-5,\"_465\":-5},{\"_331\":722,\"_603\":718,\"_781\":782,\"_461\":783,\"_39\":784,\"_464\":-5,\"_785\":-5,\"_465\":-5},\"refs\",[786],\"GitHub\",\"Sign up for GitHub\",\"pub_timestamp\",{\"_608\":609,\"_610\":620,\"_612\":677},[789],\"docs/content/account-and-profile/how-tos/account-management/creating-an-account-on-github.md at main · github/docs\",{\"_608\":609,\"_610\":620,\"_612\":126},{\"_331\":756,\"_39\":681,\"_461\":681,\"_463\":681,\"_464\":-5,\"_465\":-5,\"_466\":-5,\"_467\":184,\"_469\":681},[756],{\"_331\":755,\"_39\":462,\"_461\":462,\"_463\":462,\"_