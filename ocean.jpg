ondary,#5d5d5d))); --oai-wb-text-tertiary: var(--wb-text-tertiary,var(--color-token-text-tertiary,var(--text-tertiary,#8f8f8f))); --oai-wb-surface-primary: var(--wb-surface-primary,var(--color-token-main-surface-primary,var(--main-surface-primary,#fff))); --oai-wb-surface-secondary: var(--wb-surface-secondary,var(--color-token-bg-tertiary,var(--main-surface-secondary,#f5f5f5))); --oai-wb-interactive-secondary-hover: var(--wb-interactive-secondary-hover,var(--color-token-interactive-bg-secondary-hover,var(--oai-wb-surface-secondary))); --oai-wb-border: var(--wb-border,var(--color-token-border,var(--border-light,rgb(0 0 0/8%)))); --oai-wb-border-hover: var(--wb-border-hover,var(--color-token-border-default,var(--border-medium,rgb(0 0 0/12%)))); --oai-wb-divider: var(--wb-divider,var(--color-token-border-light,var(--border-light,rgb(0 0 0/5%)))); --oai-wb-focus: var(--wb-focus,var(--color-token-focus-border,var(--border-strong,#5b9dd9))); --oai-wb-control-border: var(--wb-control-border,var(--interactive-border-focus,var(--oai-wb-focus))); --oai-wb-entity-accent: var(--wb-entity-accent,var(--theme-entity-accent,var(--oai-wb-accent))); --oai-wb-accent: var(--wb-accent,var(--interactive-label-accent-default,#0285ff)); --oai-wb-on-accent: var(--wb-on-accent,var(--bg-primary,#fff)); --oai-wb-interactive-background: var(--wb-interactive-background,var(--interactive-bg-accent-default,color-mix(in srgb,#0285ff 12%,transparent))); --oai-wb-selection: var(--wb-selection,var(--theme-user-selection-bg,var(--selection,#93c5fd))); --oai-wb-radius: var(--wb-radius,1.5rem); --oai-wb-radius-sm: var(--wb-radius-sm,0.5rem); --oai-wb-shadow: var(--wb-shadow,0 4px 80px rgb(0 0 0/2%)); --oai-wb-shadow-lg: var(--wb-shadow-lg,0 10px 30px rgb(0 0 0/12%)); --oai-wb-font-sans: var(--wb-font-sans,var(--font-sans,sans-serif)); --oai-wb-font-mono: var(--wb-font-mono,var(--font-mono,monospace)); --oai-wb-font-size: var(--wb-font-size,0.875rem); --oai-wb-shimmer-dark-contrast: var(--wb-shimmer-dark-contrast,var(--oai-wb-text-tertiary)); --oai-wb-shimmer-dark-secondary: var(--wb-shimmer-dark-secondary,var(--oai-wb-text-tertiary));"><div contenteditable="true" aria-label="开始写作" aria-multiline="true" role="textbox" translate="no" class="ProseMirror content-xaiQhS leading-relaxed"><pre><code class="language-html"><span>&lt;!DOCTYPE html&gt;
&lt;html lang="zh-CN"&gt;
&lt;head&gt;
&lt;meta charset="UTF-8"&gt;
&lt;meta name="viewport" content="width=device-width, initial-scale=1"&gt;
&lt;title&gt;潮汐之间 · 我的主页&lt;/title&gt;
&lt;style&gt;
* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  color: #f4f4ef;
  font-family: "Microsoft YaHei", sans-serif;
  background:
    radial-gradient(ellipse at 75% 20%, #b99562 0%, transparent 25%),
    linear-gradient(180deg, #244e66, #0a2d46 55%, #061725);
}

header {
  padding: 26px 7%;
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid #ffffff30;
}

header a {
  color: #e5d3b0;
  text-decoration: none;
  margin-left: 20px;
  font-size: 12px;
}

.hero {
  padding: 100px 7% 90px;
  min-height: 62vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.label {
  color: #e5c994;
  letter-spacing: 4px;
  font-size: 11px;
}

h1 {
  font-size: clamp(44px, 8vw, 88px);
  font-weight: 400;
  margin: 25px 0 12px;
  letter-spacing: 5px;
}

h2 {
  font-size: 20px;
  font-weight: 400;
  color: #e8d8ba;
}

.intro {
  max-width: 480px;
  color: #d5e0e5;
  line-height: 2;
  font-size: 14px;
  margin: 22px 0 30px;
}

.btn {
  display: inline-block;
  width: fit-content;
  padding: 13px 22px;
  color: #102c3c;
  background: #e5c994;
  text-decoration: none;
  font-size: 13px;
}

.links {
  padding: 30px 7% 80px;
}

.links h2 {
  font-size: 26px;
  margin-bottom: 25px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.card {
  padding: 24px;
  min-height: 135px;
  color: white;
  text-decoration: none;
  background: #061c2bbd;
  border: 1px solid #ffffff30;
  transition: .2s;
}

.card:hover {
  transform: translateY(-4px);
  border-color: #e5c994;
}

.card h3 {
  font-size: 17px;
  font-weight: 400;
}

.card p {
  font-size: 12px;
  color: #c2d0d8;
  line-height: 1.8;
}

footer {
  padding: 25px 7%;
  color: #b6c5cc;
  font-size: 11px;
  border-top: 1px solid #ffffff30;
}

@media (max-width: 650px) {
  .grid { grid-template-columns: 1fr; }
  .hero { padding-top: 75px; }
  header { padding: 22px 5%; }
  header a { margin-left: 8px; }
}
&lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;
&lt;header&gt;
  &lt;span&gt;BETWEEN TIDES&lt;/span&gt;
  &lt;nav&gt;
    &lt;a href="#about"&gt;关于&lt;/a&gt;
    &lt;a href="#links"&gt;导航&lt;/a&gt;
  &lt;/nav&gt;
&lt;/header&gt;

&lt;main&gt;
&lt;section class="hero" id="about"&gt;
  &lt;div class="label"&gt;A SMALL PLACE OF MY OWN&lt;/div&gt;
  &lt;h1&gt;潮汐之间&lt;/h1&gt;
  &lt;h2&gt;在广阔世界里，慢慢成为自己。&lt;/h2&gt;
  &lt;p class="intro"&gt;
    这里收藏常去的地方、正在学习的事，
    以及那些值得停留片刻的灵感。
    海浪来去，而好奇心继续向前。
  &lt;/p&gt;
  &lt;a class="btn" href="#links"&gt;探索我的世界 ↗&lt;/a&gt;
&lt;/section&gt;

&lt;section class="links" id="links"&gt;
  &lt;div class="label"&gt;PERSONAL COMPASS&lt;/div&gt;
  &lt;h2&gt;把常去的地方，放在这里。&lt;/h2&gt;
  &lt;div class="grid"&gt;
    &lt;a class="card" href="https://www.nju.edu.cn/" target="_blank"&gt;
      &lt;h3&gt;南京大学 ↗&lt;/h3&gt;
      &lt;p&gt;校园主页 · 学习与生活&lt;/p&gt;
    &lt;/a&gt;
    &lt;a class="card" href="https://github.com/" target="_blank"&gt;
      &lt;h3&gt;GitHub ↗&lt;/h3&gt;
      &lt;p&gt;代码、项目与创造&lt;/p&gt;
    &lt;/a&gt;
    &lt;a class="card" href="https://www.bilibili.com/" target="_blank"&gt;
      &lt;h3&gt;学习与灵感 ↗&lt;/h3&gt;
      &lt;p&gt;课程、视频和有趣的发现&lt;/p&gt;
    &lt;/a&gt;
    &lt;a class="card" href="https://www.nature.com/" target="_blank"&gt;
      &lt;h3&gt;科学世界 ↗&lt;/h3&gt;
      &lt;p&gt;生命、智能与未知的问题&lt;/p&gt;
    &lt;/a&gt;
    &lt;a class="card" href="https://scholar.google.com/" target="_blank"&gt;
      &lt;h3&gt;学术探索 ↗&lt;/h3&gt;
      &lt;p&gt;论文、研究与新想法&lt;/p&gt;
    &lt;/a&gt;
    &lt;a class="card" href="https://outlook.live.com/" target="_blank"&gt;
      &lt;h3&gt;邮箱 ↗&lt;/h3&gt;
      &lt;p&gt;整理消息与日常事务&lt;/p&gt;
    &lt;/a&gt;
  &lt;/div&gt;
&lt;/section&gt;
&lt;/main&gt;

&lt;footer&gt;BETWEEN TIDES · PERSONAL HOMEPAGE&lt;/footer&gt;
&lt;/body&gt;
&lt;/html&gt;</span></code></pre></div></div></div></div></div></div></div><div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-[inherit] z-[2] [box-shadow:inset_0_0_0_1px_var(--oai-wb-border)] group-hover/writing-block-surface:[box-shadow:inset_0_0_0_1px_var(--oai-wb-border-hover)]"></div></div></div><h2 class="TextBase-hXhSqg Title-HRvkwB" data-d-text-flow="" data-d-component="title" data-d-size="lg" data-d-weight="semibold"><span data-d-text-flow="word" data-d-stream-word="">第二步：保存网页</span></h2><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">粘贴完代码后：</span></p><ol class="List-rH8nmc" data-d-component="list" data-d-marker="number" data-d-marker-layout="native" style="--d-list-row-gap: calc(var(--spacing, 0.25rem) * 0); gap: calc(var(--spacing, 0.25rem) * 0);"><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word">点击右上方的 </span><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-text-flow="word" data-d-stream-word="">Commit </span><span data-d-text-flow="word" data-d-stream-word="">changes…</span></span><span data-d-text-flow="word" data-d-stream-word="">。</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">弹出的窗口里继续点击 </span><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-text-flow="word" data-d-stream-word="">Commit </span><span data-d-text-flow="word" data-d-stream-word="">changes</span></span> <span data-d-text-flow="word" data-d-stream-word="">确认保存。</span></p></div></div></li></ol><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">这一步只是把网页代码保存到你的仓库里。</span></p><h2 class="TextBase-hXhSqg Title-HRvkwB" data-d-text-flow="" data-d-component="title" data-d-size="lg" data-d-weight="semibold"><span data-d-text-flow="word" data-d-stream-word="">第三步：发布成真正的网址</span></h2><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">保存之后：</span></p><ol class="List-rH8nmc" data-d-component="list" data-d-marker="number" data-d-marker-layout="native" style="--d-list-row-gap: calc(var(--spacing, 0.25rem) * 0); gap: calc(var(--spacing, 0.25rem) * 0);"><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">打开仓库上方的 </span><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-text-flow="word" data-d-stream-word="">Settings</span></span><span data-d-text-flow="word" data-d-stream-word="">。</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">在左侧找到 </span><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-text-flow="word" data-d-stream-word="">Pages</span></span><span data-d-text-flow="word" data-d-stream-word="">。</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">找到 </span><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-text-flow="word" data-d-stream-word="">Build </span><span data-d-text-flow="word" data-d-stream-word="">and </span><span data-d-text-flow="word" data-d-stream-word="">deployment</span></span><span data-d-text-flow="word" data-d-stream-word="">。</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><code class="Code-kbs71c" data-d-component="code"><span data-d-text-flow="word" data-d-stream-word="">Source</span></code> <span data-d-text-flow="word" data-d-stream-word="">选择 </span><code class="Code-kbs71c" data-d-component="code"><span data-d-text-flow="word" data-d-stream-word="">Deploy </span><span data-d-text-flow="word" data-d-stream-word="">from </span><span data-d-text-flow="word" data-d-stream-word="">a </span><span data-d-text-flow="word" data-d-stream-word="">branch</span></code><span data-d-text-flow="word" data-d-stream-word="">。</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><code class="Code-kbs71c" data-d-component="code"><span data-d-text-flow="word" data-d-stream-word="">Branch</span></code> <span data-d-text-flow="word" data-d-stream-word="">选择 </span><code class="Code-kbs71c" data-d-component="code"><span data-d-text-flow="word" data-d-stream-word="">main</span></code><span data-d-text-flow="word" data-d-stream-word="">，目录选择 </span><code class="Code-kbs71c" data-d-component="code"><span data-d-text-flow="word" data-d-stream-word="">/(root)</span></code><span data-d-text-flow="word" data-d-stream-word="">。</span></p></div></div></li><li class="Item-O8JWQe" data-d-component="list-item" data-d-marker-layout="native"><div class="Content-OKAHK6"><div class="Label-B5tj_e" data-d-list-item-content=""><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">点击 </span><code class="Code-kbs71c" data-d-component="code"><span data-d-text-flow="word" data-d-stream-word="">Save</span></code><span data-d-text-flow="word" data-d-stream-word="">，稍等片刻。</span></p></div></div></li></ol><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">发布成功后，GitHub </span><span data-d-text-flow="word" data-d-stream-word="">Pages </span><span data-d-text-flow="word" data-d-stream-word="">会显示你的网站地址。</span></p><h2 class="TextBase-hXhSqg Title-HRvkwB" data-d-text-flow="" data-d-component="title" data-d-size="lg" data-d-weight="semibold"><span data-d-text-flow="word" data-d-stream-word="">第四步：再加入真正流动的阳光海浪</span></h2><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span data-d-text-flow="word" data-d-stream-word="">等网页能打开后，我们再把你选中的 </span><span class="Trigger-C5mz9C" data-d-component="popover-trigger" data-d-inline="" data-d-inline-text="" role="presentation" type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed"><a class="" href="https://pixabay.com/videos/ocean-water-sunset-loop-seamless-344595/?utm_source=chatgpt.com" rel="noopener noreferrer" target="_blank"><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-inline="" data-d-text-decoration="underline-dotted"><span data-d-text-flow="word" data-d-stream-word="">金色夕阳海浪循环视频</span></span><span class="ms-1" data-d-stream-inline=""><svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" class="InlineIcon-KLrnew" data-d-component="icon" data-d-inline="" style="display: inline-block; vertical-align: calc(0.5cap - 0.5em);"><path fill-rule="evenodd" d="M16.243 6.757a1 1 0 0 1 1 1v7.072a1 1 0 0 1-2 0v-4.657L8.464 16.95a1 1 0 0 1-1.414-1.414l6.778-6.779H9.172a1 1 0 0 1 0-2h7.07Z" clip-rule="evenodd"></path></svg></span></a></span> <span data-d-text-flow="word" data-d-stream-word="">加入网站。届时只需再上传视频文件，并在代码中添加几行，就能让海浪自动播放、循环。</span></p><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-text-flow="word" data-d-stream-word="">你现在先做第一步和第二步。</span></span> <span data-d-text-flow="word" data-d-stream-word="">保存后告诉我有没有成功，我们继续把动态海洋背景做出来。</span></p></div></div></div></div></div></div></div></div></div></div><div class="mt-1.5 flex turn-action-controls min-h-5 min-w-0 max-w-(--thread-content-max-width) flex-wrap items-center justify-start gap-0.5 browser:-ms-0.5 browser:mt-3 electron:-translate-x-1 extension:-translate-x-1.5 [&amp;_button]:focus-visible:ring-2 [&amp;_button]:focus-visible:ring-ring [&amp;_button]:focus-visible:ring-offset-0 [--side-tooltip:bottom]"><div class="flex min-h-5 min-w-0 flex-wrap items-center gap-0.5 browser:gap-0"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded